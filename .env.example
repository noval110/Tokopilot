# TokoPilot — contoh environment untuk development lokal.
# Salin ke .env lalu isi nilainya. JANGAN commit file .env.
# Semua nilai di bawah adalah placeholder, bukan secret sungguhan.

# --- Shared ---
APP_ENV=development

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=tokopilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tokopilot
POSTGRES_PORT=54329

# --- Go API ---
PORT=8080
DATABASE_URL=postgresql://tokopilot:change-me-local-only@localhost:54329/tokopilot?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
STORE_DEFAULT_TIMEZONE=Asia/Jakarta
# Kunci HMAC token CSRF (ADR-0002). Minimal 32 karakter acak di staging/production;
# kosong/placeholder di development = dibuat acak per proses.
SESSION_SECRET=replace-with-strong-secret
# Batas koneksi pool per replica API (1–100). Jaga replica × DB_MAX_CONNS di bawah limit database terkelola.
DB_MAX_CONNS=10
AI_SERVICE_URL=http://localhost:8000
# Credential internal Go API -> AI service. Minimal 32 karakter acak.
AI_SERVICE_TOKEN=replace-with-service-secret

# --- AI service (FastAPI) ---
AI_PORT=8000
# Vendor LLM BELUM diputuskan (lihat docs/decisions/0006-llm-provider.md).
# "none"     = asisten nonaktif (API membalas 503 AI_NOT_CONFIGURED); health check tetap jalan.
# "scripted" = provider pengganti deterministik tanpa vendor/kunci, memakai tool sungguhan
#              (lihat docs/api/assistant.md). LLM_API_KEY tidak dipakai.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Frontend (Vite) — hanya nilai publik, tanpa secret ---
VITE_API_BASE_URL=/api/v1
