# Secrets — never commit real env files
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo

# Backend (Go)
backend/bin/
backend/tmp/
backend/coverage.out

# AI service (Python)
ai-service/.venv/
ai-service/**/__pycache__/
ai-service/.pytest_cache/
ai-service/.ruff_cache/
ai-service/.mypy_cache/
ai-service/*.egg-info/
ai-service/build/

# Logs
*.log

# Database dumps (backup drills) — never commit
backups/

# Playwright output
frontend/test-results/
frontend/playwright-report/

# Local dev stack state (scripts/dev-stack.ps1)
.dev/

# Caches and local binaries anywhere in the repo
__pycache__/
*.pyc
*.exe
